# Servido por la etapa "runtime" del Dockerfile. ${BACKEND_UPSTREAM} y ${NGINX_RESOLVER} se
# sustituyen al arrancar (envsubst de la imagen oficial). Pensado para que nginx sea el borde;
# detrás de un terminador TLS, revisar X-Forwarded-Proto y la IP de cliente.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Re-resolver el backend periódicamente: si su contenedor se recrea, cambia de IP.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $backend_upstream http://${BACKEND_UPSTREAM};

    # Cabeceras de seguridad (se repiten en cada location que usa add_header, porque no se heredan).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # API REST del backend (mismo origen: la cookie de Identity viaja sin CORS).
    location /api/ {
        # PRD §8: hasta 10 MB por archivo y varios archivos por solicitud. El backend valida el límite real.
        client_max_body_size 50m;
        proxy_pass $backend_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hubs de SignalR: requiere upgrade a WebSocket y conexiones de larga duración.
    location /hubs/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    # Assets con hash generados por Vite: inmutables; si no existen, 404 (no index.html).
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # index.html nunca se cachea: tras un despliegue debe apuntar a los assets nuevos.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # SPA: cualquier otra ruta la resuelve el router del frontend.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
