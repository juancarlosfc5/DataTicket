# Copia este archivo como .env para sobrescribir valores locales de docker-compose.yml.
# .env está en .gitignore: nunca subas credenciales reales al repositorio.

# --- Versiones de imágenes (verificadas el 2026-10-07) ---
POSTGRES_VERSION=18.6
DOTNET_VERSION=10.0
NODE_VERSION=24
MAILPIT_VERSION=v1.31
AZURITE_VERSION=3.37.0

# --- PostgreSQL ---
POSTGRES_DB=dataticket
POSTGRES_USER=dataticket
POSTGRES_PASSWORD=dataticket_local_only

# --- Puertos expuestos en el host ---
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
AZURITE_BLOB_PORT=10000
