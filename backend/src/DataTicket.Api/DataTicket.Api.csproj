<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Adaptadores primarios (HTTP y, más adelante, el hub SignalR /hubs/tickets) y composition root. -->

  <ItemGroup>
    <ProjectReference Include="..\DataTicket.Application\DataTicket.Application.csproj" />
    <ProjectReference Include="..\DataTicket.Infrastructure\DataTicket.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Solo para dotnet ef (migraciones); no se publica como dependencia. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      appsettings.Development.json activa la migración y el sembrador de Development y trae su
      contraseña sintética: no viaja en la publicación (imagen runtime). Así, fuera del entorno de
      desarrollo, un ASPNETCORE_ENVIRONMENT mal puesto no basta para sembrar cuentas.
    -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
